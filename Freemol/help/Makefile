#
# Makefile for Freemol/help
#
# There is no separate "help documents" build here: per-program help text is
# extracted from !H comments into docs/ during each program's own build (see
# programs/*/Makefile.here), and the LaTeX manuals live under manuals/.
#
all:
	@echo "Nothing to build in help/: per-program help comes from !H"
	@echo "comments, copied into docs/ during the program build; LaTeX"
	@echo "manuals are under manuals/."

clean:
	@echo "Nothing to clean in help/."
